{
  "name": "kieferwaight-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "diagrams": "node scripts/build-diagrams.mjs",
    "images:upload": "node scripts/upload-images-to-r2.mjs",
    "images:dry-run": "node scripts/upload-images-to-r2.mjs --dry-run",
    "images:add": "node scripts/add-image.mjs",
    "install-hooks": "node scripts/install-git-hooks.mjs",
    "llm-txt": "node scripts/build-llm-txt.mjs",
    "assets:manifest": "node scripts/build-asset-manifest.mjs",
    "dev": "astro dev",
    "prebuild": "npm run diagrams && npm run llm-txt && npm run assets:manifest",
    "build": "astro build",
    "test:build": "npm run build && node scripts/validate-build.mjs && node scripts/validate-links.mjs && node scripts/validate-images.mjs",
    "test:links": "node scripts/validate-links.mjs",
    "test:images": "node scripts/validate-images.mjs",
    "test:images:remote": "node scripts/validate-images.mjs --remote",
    "test:assets": "node scripts/validate-assets.mjs",
    "test:unit": "vitest run",
    "test:quality": "npm run diagrams && npm run assets:manifest && npm run check && npm run test:unit && npm run test:build && npm run test:images:remote && npm run test:assets",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "latest",
    "@astrojs/sitemap": "latest",
    "astro": "latest",
    "mermaid": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@aws-sdk/client-s3": "^3.1126.0",
    "@mermaid-js/mermaid-cli": "latest",
    "sharp": "^0.35.4",
    "typescript": "latest",
    "vitest": "^5.0.0"
  }
}