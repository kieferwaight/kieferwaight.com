---
import { getCollection, getEntry, render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Timeline from '../../../components/Timeline.astro';
import ArticleFooter from '../../../components/ArticleFooter.astro';
import ArchiveSourcePanel from '../../../components/ArchiveSourcePanel.astro';
const entry = await getEntry('archive', 'getmyboat-timeline');
const { Content } = await render(entry);
const items = await getCollection('timeline');
const displayTitle = entry.data.title.replace(/\s+\|\s+.*$/, '');
---
<SiteLayout title={entry.data.title} description={entry.data.description} type="article" image={entry.data.og_image}>
  <header class="page-intro article-header"><span class="eyebrow">Public record</span><h1>{displayTitle}</h1><p>{entry.data.description}</p><div class="article-meta"><span class="author">By {entry.data.author_name || 'Kiefer Waight'}</span><span>{new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(entry.data.date_published)}</span><span>Archive</span></div></header>
  <article class="content-shell timeline-page"><Content /><section aria-labelledby="structured-timeline"><h2 id="structured-timeline"><span class="section-number">01</span> Structured timeline</h2><Timeline items={items} /></section></article>
  <ArchiveSourcePanel entry={entry} />
  <ArticleFooter kind="archive" entryId={entry.id} />
</SiteLayout>
