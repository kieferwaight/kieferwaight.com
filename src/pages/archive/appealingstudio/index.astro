---
import { getCollection, getEntry, render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Timeline from '../../../components/Timeline.astro';
import ArticleFooter from '../../../components/ArticleFooter.astro';
import ArchiveSourcePanel from '../../../components/ArchiveSourcePanel.astro';
const entry = await getEntry('archive', 'appealingstudio');
const { Content } = await render(entry);
const items = await getCollection('studio-timeline');
const displayTitle = entry.data.title.replace(/\s+\|\s+.*$/, '');
---
<SiteLayout title={entry.data.title} description={entry.data.description} type="article" image={entry.data.og_image} schemaType={entry.data.schema_type} schemaName={entry.data.schema_name} authorName={entry.data.author_name} aboutName={entry.data.about_name} aboutType={entry.data.about_type} aboutUrl={entry.data.about_url} aboutSameAs={entry.data.about_same_as}>
  <header class="page-intro article-header"><span class="eyebrow">Archive</span><h1>{displayTitle}</h1><p>{entry.data.description}</p><div class="article-meta"><span class="author">By {entry.data.author_name || 'AppealingStudio'}</span><span>Historical record</span><span>Archive</span></div></header>
  <article class="content-shell timeline-page"><Content /><section aria-labelledby="studio-timeline"><h2 id="studio-timeline"><span class="section-number">01</span> Studio timeline</h2><Timeline items={items} /></section></article>
  <ArchiveSourcePanel entry={entry} />
  <ArticleFooter kind="archive" entryId={entry.id} />
</SiteLayout>
