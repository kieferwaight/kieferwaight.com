---
import { render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ArticleFooter from './ArticleFooter.astro';
import ArchiveSourcePanel from './ArchiveSourcePanel.astro';
const { entry, section = '' } = Astro.props;
const { Content } = await render(entry);
const isIndex = entry.id === 'index';
const isTelemetryDeepDive = entry.id.startsWith('industrial-telemetry/');
const isResume = entry.id === 'resume';
const isLocalFirstAi = entry.id === 'local-first-ai';
const isArticle = ['Article', 'BlogPosting', 'TechArticle'].includes(entry.data.schema_type);
const displayTitle = entry.data.display_title ?? entry.data.title.replace(/\s+\|\s+.*$/, '');
const formattedDate = entry.data.date_published ? new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(entry.data.date_published) : null;
---
<SiteLayout title={entry.data.title} description={entry.data.description ?? entry.data.title} type={entry.data.schema_type === 'BlogPosting' || entry.data.schema_type === 'TechArticle' ? 'article' : 'website'} published={entry.data.date_published} modified={entry.data.date_modified} image={entry.data.og_image} schemaType={entry.data.schema_type} schemaName={entry.data.schema_name} authorName={entry.data.author_name} aboutName={entry.data.about_name} aboutType={entry.data.about_type} aboutUrl={entry.data.about_url} aboutSameAs={entry.data.about_same_as}>
  <header class:list={["page-intro", { "article-header": isArticle }]}><span class="eyebrow">{section || 'Field notes'}</span><h1>{displayTitle}</h1><p>{entry.data.description}</p>{isArticle && <div class="article-meta"><span class="author">By {entry.data.author_name || 'Kiefer Waight'}</span>{formattedDate && <span>{formattedDate}</span>}<span>{section || 'Field notes'}</span></div>}</header>
  <article class:list={["content-shell", { "index-content": isIndex, "telemetry-deep-dive": isTelemetryDeepDive, "resume-content": isResume, "local-first-ai-content": isLocalFirstAi }]}><Content /></article>
  {section === 'Archive' && !isIndex && <ArchiveSourcePanel entry={entry} />}
  {['Writing', 'Case studies', 'Archive'].includes(section) && !isIndex && <ArticleFooter kind={section === 'Case studies' ? 'case-studies' : section === 'Archive' ? 'archive' : 'writing'} entryId={entry.id} />}
</SiteLayout>
