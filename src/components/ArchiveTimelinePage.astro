---
import { render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Timeline from './Timeline.astro';
import ArticleFooter from './ArticleFooter.astro';
import ArchiveSourcePanel from './ArchiveSourcePanel.astro';

const {
  entry,
  items,
  eyebrow,
  authorFallback,
  dateLabel,
  timelineId,
  timelineTitle,
} = Astro.props;
const { Content } = await render(entry);
const displayTitle = entry.data.title.replace(/\s+\|\s+.*$/, '');
---
<SiteLayout title={entry.data.title} description={entry.data.description} type="article" image={entry.data.og_image} schemaType={entry.data.schema_type} schemaName={entry.data.schema_name} authorName={entry.data.author_name} aboutName={entry.data.about_name} aboutType={entry.data.about_type} aboutUrl={entry.data.about_url} aboutSameAs={entry.data.about_same_as}>
  <header class="page-intro article-header"><span class="eyebrow">{eyebrow}</span><h1>{displayTitle}</h1><p>{entry.data.description}</p><div class="article-meta"><span class="author">By {entry.data.author_name || authorFallback}</span><span>{dateLabel}</span><span>Archive</span></div></header>
  <article class="content-shell timeline-page"><Content /><section aria-labelledby={timelineId}><h2 id={timelineId}><span class="section-number">01</span> {timelineTitle}</h2><Timeline items={items} /></section></article>
  <ArchiveSourcePanel entry={entry} />
  <ArticleFooter kind="archive" entryId={entry.id} />
</SiteLayout>