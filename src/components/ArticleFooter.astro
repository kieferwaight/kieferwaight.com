---
import { getArticleRelationship } from "../config/article-relationships";

const { kind = "writing", entryId = "" } = Astro.props;
const isCaseStudy = kind === "case-studies";
const isArchive = kind === "archive";
const { relatedCaseStudies, relatedWriting } = getArticleRelationship(entryId);
---

<footer class="article-footer">
    <div class="article-footer-group">
        <h2>Related writing</h2>
        <ul>
            {
                relatedWriting.map(([href, label]) => (
                    <li>
                        <a href={href}>{label}</a>
                    </li>
                ))
            }
        </ul>
    </div>
    <div class="article-footer-group">
        <h2>Related case studies</h2>
        <ul>
            {
                relatedCaseStudies.map(([href, label]) => (
                    <li>
                        <a href={href}>{label}</a>
                    </li>
                ))
            }
        </ul>
    </div>
    <a
        class="article-footer-back"
        href={isCaseStudy
            ? "/case-studies/"
            : isArchive
              ? "/archive/"
              : "/writing/"}
        >Back to {
            isCaseStudy
                ? "case studies"
                : isArchive
                  ? "archive"
                  : "writing index"
        }</a
    >
</footer>
