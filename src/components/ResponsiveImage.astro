---
import { getR2WebpSrcset } from '../lib/r2-image-variants.mjs';

const {
  src,
  alt = '',
  sizes = '(max-width: 700px) calc(100vw - 4rem), 38vw',
  loading = 'lazy',
  ...attributes
} = Astro.props;
const webpSrcset = getR2WebpSrcset(src);
---
{webpSrcset ? (
  <picture>
    <source srcset={webpSrcset} sizes={sizes} type="image/webp" />
    <img src={src} alt={alt} sizes={sizes} loading={loading} decoding="async" {...attributes} />
  </picture>
) : (
  <img src={src} alt={alt} loading={loading} decoding="async" {...attributes} />
)}