---
import '../styles/global.css';
import CodeBlocks from '../components/CodeBlocks.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import MobileMenu from '../components/MobileMenu.astro';

const { title, description, type = 'website', published, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://kieferwaight.com').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = savedTheme || (systemDark ? 'dark' : 'light');
    </script>
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=DM+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">Kiefer <span>Waight</span></a>
      <nav id="site-nav" aria-label="Primary navigation">
        <a href="/writing/">Writing</a>
        <a href="/case-studies/">Case studies</a>
        <a href="/research/telemetry/">Telemetry research</a>
        <a href="/resume/">About</a>
      </nav>
      <div class="header-actions">
        <ThemeToggle />
        <MobileMenu />
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><span>© {new Date().getFullYear()} Kiefer Waight</span><span>Systems, software, and the space between.</span></footer>
    <CodeBlocks />
  </body>
</html>
