    classDef ai fill:#191b4a,stroke:#6366F1,color:#e0e7ff,stroke-width:2px
    classDef infra fill:#1e293b,stroke:#64748B,color:#e2e8f0,stroke-width:2px
    class A,B,C telemetry
    class D,E,F,G ai
